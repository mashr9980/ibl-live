# =============================================================================
# LiveAvatar Sales Agent — env template
# =============================================================================
# Copy to .env.local (gitignored) and fill in, or run `npm run setup` to have
# the first section provisioned and written for you.
#
# Every var here is server-only — the app deliberately reads no NEXT_PUBLIC_*
# vars, so no key ever reaches the browser.


# =============================================================================
# 1. THE SESSION — who the agent is and how it connects
# =============================================================================
# `npm run setup` fills this whole section in. The only value it can't invent
# is your API key.

# Your LiveAvatar API key, sent as X-API-KEY when minting a session.
# Create one at app.liveavatar.com.
LIVEAVATAR_API_KEY=

# Which avatar the agent wears. The value below is Wayne, the public demo
# avatar — shared across all LiveAvatar accounts, so it works with nothing but
# your own API key. Swap in an avatar id from your account once you have one.
AI_SALES_AVATAR_ID=dd73ea75-1218-4ef3-92ce-606d5f7fbc0a

# Agent identity. Substituted for {{AGENT_NAME}} / {{AGENT_ROLE}} /
# {{PRODUCT_NAME}} / {{COMPANY_NAME}} in the prompt parts, and used for the UI
# copy and page title — change these and the agent is renamed everywhere.
# The values below are this repo's demo agent; make them yours.
AI_SALES_AGENT_NAME=Wayne
AI_SALES_AGENT_ROLE=Head of Business
AI_SALES_PRODUCT_NAME=LiveAvatar
AI_SALES_COMPANY_NAME=HeyGen

# REQUIRED. The context supplies the avatar's `opening_text` — the first thing
# it says when the room connects, before any model is in the loop. Without one
# the avatar connects and then sits silent.
#
# `npm run setup` creates one whose opening text is exactly ${opening_intro},
# the placeholder this app fills per visitor with a greeting built from their
# name (and company, if a lead resolver is configured). Creating it by hand
# (POST /v1/contexts) works too — just keep that placeholder.
AI_SALES_CONTEXT_ID=

AI_SALES_VOICE_ID=               # OPTIONAL voice UUID; blank = the avatar's default voice
AI_SALES_LANGUAGE=en             # OPTIONAL spoken language; default en

# Hard cap per session, in seconds. Must be <= your account tier's limit or
# the mint is rejected. Default 600 (10 minutes).
AI_SALES_MAX_SESSION_DURATION=
LIVEAVATAR_API_URL=https://api.liveavatar.com


# =============================================================================
# 2. THE BRAIN — Manage the context better. 
# =============================================================================
# Without this section the avatar still connects and greets people, but the
# conversation runs on your account's default LLM instead of this app's prompt.

# Anthropic key — powers both the conversation and the session-end summary.
ANTHROPIC_API_KEY=

# The API key that protects this app's own /api/chat/completions endpoint.
#
# That endpoint is an OpenAI-compatible LLM served by THIS app, and LiveAvatar
# calls it over the public internet on every conversational turn. You pick the
# value (any strong random string — `openssl rand -hex 32`) and register the
# SAME value with LiveAvatar when you create the LLM configuration:
#
#   1. POST /v1/secrets            { secret_type: "OPENAI_API_KEY",
#                                    secret_value: "<this value>" }   -> secret_id
#   2. POST /v1/llm-configurations { secret_id, model_name,
#                                    base_url: "https://<app>/api" }
#                                                                     -> llm_configuration_id
#
#      base_url is the BASE — LiveAvatar appends /chat/completions itself,
#      like any OpenAI client. Including the route 404s and the agent stays
#      silent after its opening line.
#
# `npm run setup -- --url https://<your-app>` does both and fills in each id.
#
# At runtime LiveAvatar presents it back as `Authorization: Bearer <value>`,
# exactly as it would to OpenAI, and this app compares the two in constant time.
#
# REQUIRED once a configuration exists — the route returns 500 while it is
# unset rather than serving unauthenticated. Without it, anyone who finds your
# deployment's URL could spend your ANTHROPIC_API_KEY, read your full system
# prompt out of the response, or probe the lead resolver with arbitrary emails.
AI_SALES_LLM_CONFIG_API_KEY=

# Routes each conversational turn to this app's /api/chat/completions.
# Blank = the account's default LLM answers instead, and none of the prompt
# parts below are used.
LLM_CONFIGURATION_ID=

# OPTIONAL. The system prompt is assembled from the *.md files in
# src/lib/ai-sales/brain/prompt-parts/, in filename order. Point this at
# another directory to replace the bundled prompt wholesale at deploy time
# (absolute, or relative to the working directory).
PROMPT_PARTS_DIR=

# OPTIONAL — CRM enrichment. Selects the LeadResolver implementation. Leave
# blank for the no-op stub: no lookups, no network calls, every visitor treated
# as a cold lead. To enrich from your own CRM, implement the interface in
# src/lib/ai-sales/lead-resolver/ (start from stub.ts), register it there under
# a name of your choosing, and set that name here.
AI_SALES_LEAD_RESOLVER=


# =============================================================================
# 3. AFTER THE CALL — summary fan-out
# =============================================================================
# On disconnect the app summarizes the transcript and writes it out. Both
# integrations are independent; leave either blank to skip it.

NOTION_TOKEN=
NOTION_DATABASE_ID=
SLACK_WEBHOOK_URL=

# HMAC that binds /api/ai-sales/session-end to a session this app actually
# minted. Never leaves your deployment. Fail-closed: while unset, session-end
# returns 500 and nothing is written. `npm run setup` generates one.
AI_SALES_SESSION_SIGNING_SECRET=
